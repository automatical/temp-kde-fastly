{
  "timestamp": "%{strftime(\{"%Y-%m-%dT%H:%M:%S%z"\}, time.start)}V",
  "request_id": "%{req.xid}V",
  "service_id": "%{req.service_id}V",
  "service_version": "%{req.vcl.version}V",
  "pop": "%{server.datacenter}V",
  "pop_region": "%{server.region}V",
  "elapsed_us": %{time.elapsed.usec}V,
  "cache_state": "%{fastly_info.state}V",

  "client_ip": "%{req.http.Fastly-Client-IP}V",
  "x_forwarded_for": "%{json.escape(req.http.X-Forwarded-For)}V",

  "host": "%{json.escape(req.http.Host)}V",
  "method": "%{json.escape(req.method)}V",
  "url": "%{json.escape(req.url)}V",
  "protocol": "%{req.proto}V",
  "is_h2": %{if(fastly_info.is_h2, "true", "false")}V,
  "is_h3": %{if(fastly_info.is_h3, "true", "false")}V,
  "status": %{resp.status}V,
  "content_type": "%{json.escape(resp.http.Content-Type)}V",
  "request_bytes": %{req.bytes_read}V,
  "response_bytes": %{resp.bytes_written}V,

  "geo_continent": "%{client.geo.continent_code}V",
  "geo_country": "%{client.geo.country_code}V",
  "geo_region": "%{json.escape(client.geo.region)}V",
  "geo_city": "%{json.escape(client.geo.city.utf8)}V",
  "geo_postal_code": "%{json.escape(client.geo.postal_code)}V",
  "geo_latitude": %{client.geo.latitude}V,
  "geo_longitude": %{client.geo.longitude}V,
  "geo_conn_type": "%{client.geo.conn_type}V",
  "geo_proxy_type": "%{client.geo.proxy_type}V",
  "geo_proxy_description": "%{client.geo.proxy_description}V",

  "asn": %{client.as.number}V,
  "asn_name": "%{json.escape(client.as.name)}V",

  "tls_protocol": "%{tls.client.protocol}V",
  "tls_cipher": "%{tls.client.cipher}V",
  "tls_sni": "%{json.escape(tls.client.servername)}V",
  "ja3": "%{json.escape(req.http.X-JA3)}V",
  "ja4": "%{json.escape(req.http.X-JA4)}V",
  "h2_fingerprint": "%{json.escape(req.http.X-H2-Fingerprint)}V",

  "blocklist_match": "%{json.escape(req.http.X-Blocklist-Match)}V",
  "blocklist_action": "%{json.escape(req.http.X-Blocklist-Action)}V",

  "user_agent": "%{json.escape(req.http.User-Agent)}V",
  "referer": "%{json.escape(req.http.Referer)}V",
  "origin": "%{json.escape(req.http.Origin)}V",
  "accept": "%{json.escape(req.http.Accept)}V",
  "accept_language": "%{json.escape(req.http.Accept-Language)}V",
  "accept_encoding": "%{json.escape(req.http.Accept-Encoding)}V",
  "sec_ch_ua": "%{json.escape(req.http.Sec-CH-UA)}V",
  "sec_ch_ua_mobile": "%{json.escape(req.http.Sec-CH-UA-Mobile)}V",
  "sec_ch_ua_platform": "%{json.escape(req.http.Sec-CH-UA-Platform)}V",
  "sec_ch_ua_platform_version": "%{json.escape(req.http.Sec-CH-UA-Platform-Version)}V",
  "sec_ch_ua_arch": "%{json.escape(req.http.Sec-CH-UA-Arch)}V",
  "sec_ch_ua_model": "%{json.escape(req.http.Sec-CH-UA-Model)}V",
  "sec_ch_ua_full_version_list": "%{json.escape(req.http.Sec-CH-UA-Full-Version-List)}V",
  "sec_fetch_site": "%{json.escape(req.http.Sec-Fetch-Site)}V",
  "sec_fetch_mode": "%{json.escape(req.http.Sec-Fetch-Mode)}V",
  "sec_fetch_dest": "%{json.escape(req.http.Sec-Fetch-Dest)}V",
  "sec_fetch_user": "%{json.escape(req.http.Sec-Fetch-User)}V"
}
